# a2a-auction 데몬 5개 부트스트랩 시크릿 — 이 파일을 .env로 복사해 값을 채우세요.
#   cp infra/.env.example infra/.env
# .env는 gitignore 대상입니다. 실제 값은 커밋하지 마세요.

# WAIaaS 데몬 이미지. WAIaaS 레포에서 로컬 빌드한 태그를 씁니다.
#   (WAIaaS 레포에서) docker compose -f docker-compose.yml -f docker-compose.build.yml build
WAIAAS_IMAGE=waiaas-daemon:local

# 데몬 5개의 마스터 패스워드. 각각 다른 임의 문자열을 쓰세요.
#   생성 예: openssl rand -hex 24
BUYER_A_MASTER_PASSWORD=
BUYER_B_MASTER_PASSWORD=
BUYER_C_MASTER_PASSWORD=
SELLER_MASTER_PASSWORD=
MARKETPLACE_MASTER_PASSWORD=

# 데몬(컨테이너)이 보는 체인 주소.
# host.docker.internal은 컨테이너에서 호스트를 가리키는 이름이라 **호스트 LAN IP가 바뀌어도
# 그대로 동작합니다**(compose의 extra_hosts로 /etc/hosts에 주입). IP를 직접 적지 마세요.
# 이 줄을 지우면 데몬이 실제 devnet(api.devnet.solana.com)을 봅니다.
LOCALNET_RPC=http://host.docker.internal:8899

# Gemini API 키 (미설정 시 캐시된 생성물로 폴백 — 데모는 그대로 완주합니다).
# 신규 발급 키는 GEMINI_MODEL을 함께 지정해야 합니다. 기본값 gemini-2.5-flash는
# 신규 키에서 404가 납니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
